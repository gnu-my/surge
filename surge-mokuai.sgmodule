#!name=自用广告净化
#!desc=自用广告净化
#!category=广告净化

[URL Rewrite]
# 瓜子漫画 - 站内广告脚本与广告图片路径阻断
^https?://.*guazimanhua\.com/assets/reader/mobile-bottom-ad\.js.* - reject-200
^https?://.*guazimanhua\.com/assets/ads/mobile-reader-bottom-creative.*\.js.* - reject-200


[Body Rewrite]
# 瓜子漫画 - 隐藏广告占位框
http-response ^https?://.*guazimanhua\.com/.* (<head.*?>) $1<style>.desktop-reader-top-ad,.pc-reader-bottom-image-spacer,.pc-reader-bottom-image-ad,.mobile-reader-top-static-ad,[aria-label="广告"],#guazi-mobile-js-ad-spacer,[id*="gsagewadw"],[id*="swipercontainer"],[id*="anceng"],[id*="anshua"],[id*="diantan"],[id*="alabelbox"],[id*="ababoxjia"],[id*="iframeid"],iframe[src*="r12ukq68l8"],img[src*="akosscdn"],[id*="top-ad"],[class*="top-ad"],[class*="header-ad"],[id*="banner"],[class*="banner-ad"],div[style*="position: fixed"][style*="top: 0"]{display:none!important;height:0!important;min-height:0!important;max-height:0!important;width:0!important;min-width:0!important;max-width:0!important;margin:0!important;padding:0!important;border:none!important;visibility:hidden!important;opacity:0!important;pointer-events:none!important;transform:scale(0)!important;overflow:hidden!important;}</style>


[MITM]
hostname = www.guazimanhua.com
