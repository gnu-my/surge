#!name=瓜子漫画净化
#!desc=移除瓜子漫画站内广告脚本、图片及页面推广占位框
#!category=广告净化

[URL Rewrite]
# 瓜子漫画 - 站内广告脚本与广告图片路径阻断
^https?:\/\/www\.guazimanhua\.com\/assets\/reader\/mobile-.*-ad\.js$ - reject-200
^https?:\/\/www\.guazimanhua\.com\/assets\/ad\/ - reject-200

[Body Rewrite]
# 瓜子漫画 - 隐藏广告占位框
http-response ^https?:\/\/www\.guazimanhua\.com\/.* (<head.*?>) $1<style>.desktop-reader-top-ad,.mobile-reader-top-static-ad,[aria-label="推广"]{display:none!important;height:0!important;margin:0!important;padding:0!important;}</style>

[MITM]
hostname = %APPEND% www.guazimanhua.com
