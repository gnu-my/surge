#!name=自用广告净化
#!desc=自用广告净化
#!category=广告净化

[URL Rewrite]
# 瓜子漫画 - 站内广告脚本与广告图片路径阻断
^https?:\/\/www\.guazimanhua\.com\/assets\/reader\/mobile-.*-ad\.js$ - reject-200
^https?:\/\/www\.guazimanhua\.com\/assets\/ad\/ - reject-200


[Body Rewrite]
# 瓜子漫画 - 隐藏广告占位框
http-response ^https?://.*guazimanhua\.com/.* (<head.*?>) $1<style>.desktop-reader-top-ad,.pc-reader-bottom-image-spacer,.pc-reader-bottom-image-ad,.mobile-reader-top-static-ad,[aria-label="广告"],#guazi-mobile-js-ad-spacer,[id$="90091"],iframe[id^="iframeid"],h5[class*="swiper-container"],img[src*="ACloudMerge"],[id*="top-ad"],[class*="top-ad"],[class*="header-ad"],[id*="banner"],[class*="banner-ad"],div[style*="position: fixed"][style*="top: 0"],div[style*="position:fixed"][style*="top:0"]{display:none!important;height:0!important;margin:0!important;padding:0!important;visibility:hidden!important;}</style>


[MITM]
hostname = www.guazimanhua.com
