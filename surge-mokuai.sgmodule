#!name=自用广告净化
#!desc=自用广告净化
#!category=广告净化

[URL Rewrite]
# 瓜子漫画 - 站内广告脚本与广告图片路径阻断
^https?://.*guazimanhua\.com/assets/reader/mobile-bottom-ad\.js.* - reject-200
^https?://.*guazimanhua\.com/assets/ads/mobile-reader-bottom-creative.*\.js.* - reject-200


[Body Rewrite]
# 瓜子漫画 - 隐藏广告占位框
http-response ^https?://.*guazimanhua\.com/.* (<head.*?>) $1<style>h5,#guazi-mobile-js-ad-spacer,.desktop-reader-top-ad,.pc-reader-bottom-image-spacer,.pc-reader-bottom-image-ad,.mobile-reader-top-static-ad,[aria-label="广告"],img[src*="akosscdn"],img[src*="ACloudMerge"]{display:none!important;}</style>


[MITM]
hostname = www.guazimanhua.com
