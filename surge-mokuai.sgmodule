#!name=自用广告净化
#!desc=自用广告净化
#!category=广告净化

[URL Rewrite]
# 1. 拦截生成广告的JS源头
^https?:\/\/.*\.guazimanhua\.com\/assets\/(ads|reader\/(mobile-top-static-ad|mobile-bottom-ad|pc-common-banner|pc-reader-bottom-image|reading-event)|analytics\/baidu-tongji) url reject-200
^https?:\/\/.*\.guazimanhua\.com\/free-comics\/mobile-bottom-ad-status\.php url reject-200

[Body Rewrite]
# 2. 隐藏残余占位符
http-response ^https?://.*\.guazimanhua\.com/.* (<head.*?>) $1<style>.desktop-reader-top-ad,.pc-reader-bottom-image-spacer,.pc-reader-bottom-image-ad,.mobile-reader-top-static-ad,[aria-label="广告"],#guazi-mobile-js-ad-spacer{display:none!important;}</style>

[MITM]
hostname = *.guazimanhua.com
