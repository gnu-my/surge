#!name=自用广告净化
#!desc=移除瓜子漫画站内广告脚本、图片及页面推广占位框
#!category=广告净化

[URL Rewrite]
# 瓜子漫画 - 站内广告脚本与广告图片路径阻断
^https?:\/\/www\.guazimanhua\.com\/assets\/reader\/mobile-.*-ad\.js$ - reject-200
^https?:\/\/www\.guazimanhua\.com\/assets\/ad\/ - reject-200

[Body Rewrite]
# 瓜子漫画 - 隐藏广告占位框
http-response ^https?:\/\/(www\.)?guazimanhua\.com\/(chapter|comic)\.php (<\/head>) "<style>.ad, .ads, .adv, .adsbygoogle, [class*='ad-'], [class*='ads-'], [class*='banner'], [id*='ad_'], [id*='ads_'], iframe[src*='ad'] { display: none !important; height: 0 !important; max-height: 0 !important; overflow: hidden !important; pointer-events: none !important; }</style>$1"

[MITM]
hostname = %APPEND% www.guazimanhua.com
