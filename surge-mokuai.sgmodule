#!name=自用广告净化
#!desc=自用广告净化
#!category=广告净化

[URL Rewrite]
# 瓜子漫画 - 站内广告脚本与广告图片路径阻断
^https?:\/\/www\.guazimanhua\.com\/assets\/reader\/mobile-.*-ad\.js$ _ reject
^https?:\/\/www\.guazimanhua\.com\/assets\/ad\/ _ reject

[Body Rewrite]
# 瓜子漫画 - 隐藏广告占位框
http-response ^https?:\/\/www\.guazimanhua\.com\/.* (<head[^>]*>) $1<style>body{outline:5px solid red!important;}</style>



[MITM]
hostname = www.guazimanhua.com
