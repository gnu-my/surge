#!name=自用广告净化
#!desc=移除瓜子漫画站内广告脚本、图片及页面推广占位框
#!category=广告净化

[URL Rewrite]
# 瓜子漫画 - 站内广告脚本与广告图片路径阻断
^https?:\/\/www\.guazimanhua\.com\/assets\/reader\/mobile-.*-ad\.js$ - reject-200
^https?:\/\/www\.guazimanhua\.com\/assets\/ad\/ - reject-200

[Body Rewrite]
# 瓜子漫画 - 隐藏广告占位框
http-response ^https?:\/\/(www\.)?guazimanhua\.com\/(chapter|comic)\.php (<\/head>) "<style>div.mobile-reader-top-static-ad{display:none!important;height:0!important;min-height:0!important;overflow:hidden!important;}#guazi-ios-ad-image,[id*='_0_'],[id*='_1_'],[id*='_2_'],[id*='_3_'],[class*='_a'],[class*='_c']{display:none!important;width:0!important;height:0!important;pointer-events:none!important;opacity:0!important;}</style>$1"

[MITM]
hostname = %APPEND% www.guazimanhua.com
